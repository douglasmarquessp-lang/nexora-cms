# Nexora CMS — Configuração de Ambiente
# Copie este arquivo para .env e ajuste os valores

# === Servidor ===
# SERVER_PORT tem prioridade; PORT é usado como fallback (compatível com Railway)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_TIMEOUT=30s

# === Migrations ===
# Executadas automaticamente no startup da API, antes do Casbin/kernel/HTTP
MIGRATIONS_DIR=migrations
MIGRATION_TIMEOUT=10m

# === Banco de Dados ===
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=nexora
DATABASE_PASSWORD=nexora_secret
DATABASE_NAME=nexora
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# === Admin: seleção de sites ===
# SITES_WHITELIST: quando preenchida, apenas estes sites aparecem no seletor
# de sites do Admin (lista separada por vírgula). Vazio = todos os sites.
# Entradas inválidas são ignoradas.
SITES_WHITELIST=

# --- Idioma padrão por site (interno, ver internal/pkg/sitelang) ----------
# AIWorkSimple (a64d7d72-b97f-4f31-96fd-8aeb15f6184c) está pinado para "en":
# todo conteúdo gerado/publicado nesse site será em inglês, independente do
# que o chamador da API solicitar. Outros sites mantêm o comportamento
# global (pedido explícito honrado, senão "pt").

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# === Autenticação ===
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# === OAuth ===
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback

# === Armazenamento ===
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./data/storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_ENDPOINT=

# === Cache ===
CACHE_DRIVER=memory
CACHE_TTL=5m

# === Research Intelligence ===
# How long a deep research result (briefing + fact base + sources) is reused
# for the same topic before a new multi-source search runs. Zero/empty = 24h.
RESEARCH_CACHE_TTL=24h

# === AI / Gemini ===
AI_ENABLED=false
AI_DEFAULT_PROVIDER=gemini
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_GEMINI_TIMEOUT=60s
AI_GEMINI_RETRIES=3
AI_GEMINI_WEIGHT=10
AI_GEMINI_PRIORITY=1
AI_GEMINI_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1s
AI_RETRY_MAX_DELAY=30s
AI_CB_FAILURE_THRESHOLD=5
AI_CB_SUCCESS_THRESHOLD=2
AI_CB_HALF_OPEN_TIMEOUT=30s
AI_GLOBAL_TIMEOUT=120s

# === SEO Intelligence Engine ===
# Score minimo de auditoria (0-100) para permitir publicacao automatica de
# conteudo gerado. Artigos abaixo deste valor sao bloqueados pelo gate de
# publicacao. Defina como 0 para desabilitar o gate.
SEO_MIN_PUBLISH_SCORE=70
# Dominios de concorrentes (CSV). Links externos para estes dominios sao
# sempre bloqueados pelo enriquecedor de links.
SEO_COMPETITOR_DOMAINS=
# Score minimo (0-100) de relevancia para um link interno ser inserido
# automaticamente antes da publicacao.
SEO_INTERNAL_LINK_MIN_SCORE=40
# Numero maximo de links internos inseridos automaticamente por artigo.
SEO_INTERNAL_LINK_MAX=5
# Confiabilidade minima (0-100) de um dominio para receber link externo
# automatico (fontes oficiais/documentacao/pesquisas).
SEO_EXTERNAL_LINK_MIN_RELIABILITY=75
# Assinatura padrao usada na analise EEAT de artigos gerados sem autor
# explicito (ex.: "Equipe AIWorkSimple"). Vazio desativa.
SEO_DEFAULT_AUTHOR=

# === Pexels (imagens para artigos gerados) ===
# Chave da API Pexels (https://www.pexels.com/api/). O provider enriquece os
# artigos gerados com uma foto real (featured image + <img> no corpo + ALT).
# Vazia = provider desabilitado (artigos publicam sem imagem, perdendo o
# criterio Images do SEO gate). A chave NUNCA e logada nem exposta.
PEXELS_API_KEY=
PEXELS_TIMEOUT=8s

# === Freshness Engine + News Intelligence ===
# Habilita a reavaliacao diaria (once-per-day) de artigos publicados:
# reavalia freshness, verifica novidades e marca "Needs Update".
FRESHNESS_SWEEP_ENABLED=true
# Janela temporal para conteudo NEWS (dias). Fontes mais antigas que isso
# ficam fora da janela de pesquisa.
FRESHNESS_NEWS_MAX_DAYS=30
# Corte absoluto para NEWS: noticias com mais de N dias nunca sao usadas.
FRESHNESS_NEWS_NEVER_OLDER_DAYS=90

# === AI Editorial Brain ===
# Nota editorial final minima (0-100) para publicacao. Abaixo dela o artigo
# retorna automaticamente para revisao (gate fail-open: sem review gravada,
# a publicacao nao e bloqueada). 0 desativa o gate.
EDITORIAL_MIN_FINAL_SCORE=90

# === Revalidacao ISR (Next.js) ===
# Base URL(s) do site publico (separadas por virgula). O API chama
# {url}/api/revalidate apos cada publicacao para o cache ISR expirar.
# Fail-open: se o webhook falhar, a publicacao NAO e bloqueada.
SITE_PUBLIC_URLS=
# Token secreto compartilhado com SITE_REVALIDATE_TOKEN do site publico.
SITE_REVALIDATE_TOKEN=
# Ativa/desativa o webhook (sem URLs ou token ele vira no-op).
SITE_REVALIDATION_ENABLED=true
# Timeout por POST (default 5s).
SITE_REVALIDATE_TIMEOUT=5s

# === Modo de Desenvolvimento ===
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=console
