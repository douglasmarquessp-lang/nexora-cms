# Nexora CMS — Frontend Environment Variables
# Copy this file to .env.local and adjust values

# API Base URL (the backend Go API)
# In production, set this to your actual API domain
NEXT_PUBLIC_API_URL=http://localhost:8080

# In production, set these for multi-tenancy:
# NEXT_PUBLIC_SITE_ID=<your-site-uuid>
# NEXT_PUBLIC_SITE_NAME=Nexora CMS
